Thumbs.db
*.swp
*~
.idea/
.vscode/

# Agent/session scratch — never commit run artifacts or resolved instance config
.claude/
.claude-flow/
.swarm/
*.local.yaml
*.local.md
.packs.yaml
scratch/
tmp/
